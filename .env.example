# --- Server ---
PORT=3009
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Request body limit for this API, bytes. Must be above MAX_EVENT_BYTES.
BODY_LIMIT=131072

# --- Storage ---
DB_PATH=./data/webhook-out.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=
# Events older than this are deleted together with their deliveries, whatever their status.
EVENT_RETENTION_DAYS=30
# Encrypts subscriber secrets at rest (AES-256-GCM). 64 hex chars. Generate: openssl rand -hex 32
# Losing it makes every stored secret unreadable; rotate subscriptions afterwards.
SECRETS_KEY=REPLACE_WITH_64_HEX_CHARS

# --- Callers: id:secret[:role], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: publish (POST /v1/events only, for your backends), write (manage subscriptions and deliveries, publish),
# read (list, stats, metrics), readwrite (default).
WEBHOOK_API_KEYS=console:REPLACE_WITH_64_HEX_CHARS,shop-backend:REPLACE_WITH_64_HEX_CHARS:publish
# Requests per key per minute.
RATE_LIMIT_MAX=1200

# --- Deliveries ---
# Plain http:// receivers. Default false.
TARGET_ALLOW_HTTP=false
# Receivers on private, loopback or link-local addresses. Requires TARGET_ALLOWED_HOSTS.
TARGET_ALLOW_PRIVATE=false
# Host allowlist, comma separated; exact host or parent domain. Empty = any public host.
TARGET_ALLOWED_HOSTS=
# Delays in seconds before retry 1, 2, 3, …; non-decreasing. Attempts = entries + 1.
RETRY_SCHEDULE_SEC=60,300,1800,7200,21600,86400
# Per-call timeout.
DELIVERY_TIMEOUT_MS=15000
# Calls executing at the same time; how often the queue is polled.
WORKER_CONCURRENCY=16
# Cap on one unordered subscription's in-flight deliveries, so one noisy subscription can't consume
# the whole WORKER_CONCURRENCY. An ordered subscription's effective cap is always 1, regardless.
SUBSCRIPTION_CONCURRENCY_MAX=4
POLL_MS=1000
# A subscription is disabled after this many consecutive deliveries that exhausted their retries.
DISABLE_AFTER_FAILURES=10
# Largest JSON-encoded event data.
MAX_EVENT_BYTES=65536
# After a secret rotation the previous secret keeps signing for this long (0 = cut over at once).
PREV_SECRET_GRACE_HOURS=24

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=webhook-out:…:write
AUDIT_URL=
AUDIT_API_KEY=
